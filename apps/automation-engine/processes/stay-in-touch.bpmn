<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="stay-in-touch-definitions" targetNamespace="https://phxhomeloan.com/automation/lead-journey">
  <bpmn:process id="stay-in-touch" name="Stay in Touch" isExecutable="true" camunda:historyTimeToLive="760">
    <bpmn:documentation>Monthly email until 12 months pass without any action (spec #164). Called by the Lead Journey's Marketing phase with senderBrand, timeZone, and monthsWithoutAction = 0. A click or a reply (message EngagementRecorded) starts the 12 months again.</bpmn:documentation>
    <bpmn:startEvent id="StayInTouchStarted" name="Stay in Touch started" />
    <bpmn:sequenceFlow id="Flow_StartToMonth" sourceRef="StayInTouchStarted" targetRef="WaitOneMonth" />
    <bpmn:intermediateCatchEvent id="WaitOneMonth" name="30 days">
      <bpmn:timerEventDefinition id="WaitOneMonthTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_MonthToGateway" sourceRef="WaitOneMonth" targetRef="TwelveMonthsGateway" />
    <bpmn:exclusiveGateway id="TwelveMonthsGateway" name="12 months without action?" default="Flow_KeepInTouch" />
    <bpmn:sequenceFlow id="Flow_TwelveMonths" name="yes" sourceRef="TwelveMonthsGateway" targetRef="StayInTouchFinished">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${monthsWithoutAction &gt;= 12}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="StayInTouchFinished" name="No action for 12 months" />
    <bpmn:sequenceFlow id="Flow_KeepInTouch" name="no" sourceRef="TwelveMonthsGateway" targetRef="CheckSendWindow" />
    <bpmn:businessRuleTask id="CheckSendWindow" name="Check send window" camunda:decisionRef="sendWindow" camunda:decisionRefBinding="latest" camunda:resultVariable="waitHours" camunda:mapDecisionResult="singleEntry" />
    <bpmn:sequenceFlow id="Flow_SendWindowToGateway" sourceRef="CheckSendWindow" targetRef="OutsideSendWindowGateway" />
    <bpmn:exclusiveGateway id="OutsideSendWindowGateway" name="Outside send window?" default="Flow_InsideSendWindow" />
    <bpmn:sequenceFlow id="Flow_OutsideSendWindow" name="yes" sourceRef="OutsideSendWindowGateway" targetRef="WaitForSendWindow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${waitHours &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="WaitForSendWindow" name="Wait until the window opens">
      <bpmn:timerEventDefinition id="WaitForSendWindowTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT${waitHours}H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_WindowOpenToSend" sourceRef="WaitForSendWindow" targetRef="SendMonthlyEmail" />
    <bpmn:sequenceFlow id="Flow_InsideSendWindow" name="no" sourceRef="OutsideSendWindowGateway" targetRef="SendMonthlyEmail" />
    <bpmn:serviceTask id="SendMonthlyEmail" name="Send monthly email" camunda:type="external" camunda:topic="email.send">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="templateKey">stay-in-touch</camunda:inputParameter>
          <camunda:outputParameter name="monthsWithoutAction">${monthsWithoutAction + 1}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SendToMonth" sourceRef="SendMonthlyEmail" targetRef="WaitOneMonth" />
    <bpmn:subProcess id="EngagementSubprocess" name="Engagement recorded" triggeredByEvent="true">
      <bpmn:startEvent id="EngagementRecorded" name="Click or reply" isInterrupting="false">
        <bpmn:messageEventDefinition id="EngagementRecordedDefinition" messageRef="Message_EngagementRecorded" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_EngagementToReset" sourceRef="EngagementRecorded" targetRef="ResetMonths" />
      <bpmn:intermediateThrowEvent id="ResetMonths" name="Start the 12 months again">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="monthsWithoutAction">${0}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_ResetToEnd" sourceRef="ResetMonths" targetRef="EngagementHandled" />
      <bpmn:endEvent id="EngagementHandled" name="Engagement handled" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_EngagementRecorded" name="EngagementRecorded" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_stay-in-touch">
    <bpmndi:BPMNPlane id="BPMNPlane_stay-in-touch" bpmnElement="stay-in-touch">
      <bpmndi:BPMNShape id="BPMNShape_StayInTouchStarted" bpmnElement="StayInTouchStarted">
        <dc:Bounds x="80" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="72" y="128" width="53" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_WaitOneMonth" bpmnElement="WaitOneMonth">
        <dc:Bounds x="216" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="209" y="68" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_TwelveMonthsGateway" bpmnElement="TwelveMonthsGateway" isMarkerVisible="true">
        <dc:Bounds x="352" y="80" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="344" y="33" width="67" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_StayInTouchFinished" bpmnElement="StayInTouchFinished">
        <dc:Bounds x="534" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="519" y="128" width="66" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_CheckSendWindow" bpmnElement="CheckSendWindow">
        <dc:Bounds x="502" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_OutsideSendWindowGateway" bpmnElement="OutsideSendWindowGateway" isMarkerVisible="true">
        <dc:Bounds x="702" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="684" y="207" width="87" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_WaitForSendWindow" bpmnElement="WaitForSendWindow">
        <dc:Bounds x="852" y="407" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="832" y="448" width="77" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_SendMonthlyEmail" bpmnElement="SendMonthlyEmail">
        <dc:Bounds x="988" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EngagementSubprocess" bpmnElement="EngagementSubprocess">
        <dc:Bounds x="80" y="523" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToMonth" bpmnElement="Flow_StartToMonth">
        <di:waypoint x="116" y="105" />
        <di:waypoint x="216" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_MonthToGateway" bpmnElement="Flow_MonthToGateway">
        <di:waypoint x="252" y="105" />
        <di:waypoint x="352" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_TwelveMonths" bpmnElement="Flow_TwelveMonths">
        <di:waypoint x="402" y="105" />
        <di:waypoint x="534" y="105" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="83" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_InsideSendWindow" bpmnElement="Flow_InsideSendWindow">
        <di:waypoint x="752" y="265" />
        <di:waypoint x="988" y="265" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="861" y="243" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SendToMonth" bpmnElement="Flow_SendToMonth">
        <di:waypoint x="1038" y="305" />
        <di:waypoint x="1038" y="325" />
        <di:waypoint x="234" y="325" />
        <di:waypoint x="234" y="123" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_KeepInTouch" bpmnElement="Flow_KeepInTouch">
        <di:waypoint x="377" y="130" />
        <di:waypoint x="377" y="265" />
        <di:waypoint x="502" y="265" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="383" y="191" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SendWindowToGateway" bpmnElement="Flow_SendWindowToGateway">
        <di:waypoint x="602" y="265" />
        <di:waypoint x="702" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OutsideSendWindow" bpmnElement="Flow_OutsideSendWindow">
        <di:waypoint x="727" y="290" />
        <di:waypoint x="727" y="425" />
        <di:waypoint x="852" y="425" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="732" y="351" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_WindowOpenToSend" bpmnElement="Flow_WindowOpenToSend">
        <di:waypoint x="870" y="407" />
        <di:waypoint x="870" y="325" />
        <di:waypoint x="1038" y="325" />
        <di:waypoint x="1038" y="305" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_EngagementSubprocess">
    <bpmndi:BPMNPlane id="BPMNPlane_EngagementSubprocess" bpmnElement="EngagementSubprocess">
      <bpmndi:BPMNShape id="BPMNShape_EngagementRecorded" bpmnElement="EngagementRecorded">
        <dc:Bounds x="80" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="69" y="121" width="59" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ResetMonths" bpmnElement="ResetMonths">
        <dc:Bounds x="216" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="121" width="88" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EngagementHandled" bpmnElement="EngagementHandled">
        <dc:Bounds x="352" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="331" y="121" width="79" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_EngagementToReset" bpmnElement="Flow_EngagementToReset">
        <di:waypoint x="116" y="98" />
        <di:waypoint x="216" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ResetToEnd" bpmnElement="Flow_ResetToEnd">
        <di:waypoint x="252" y="98" />
        <di:waypoint x="352" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
