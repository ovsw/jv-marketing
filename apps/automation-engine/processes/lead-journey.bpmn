<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="lead-journey-definitions" targetNamespace="https://phxhomeloan.com/automation/lead-journey">
  <bpmn:process id="lead-journey" name="Lead Journey" isExecutable="true" camunda:historyTimeToLive="760">
    <bpmn:documentation>The whole relationship with one Person, from the Assessment to a Mortgage Application (spec #164). The business key is the Person's Shared CRM record ID. Tasks for a person start with "Jimmy:" or "Team:".</bpmn:documentation>
    <bpmn:startEvent id="AssessmentSubmitted" name="Assessment submitted">
      <bpmn:messageEventDefinition id="AssessmentSubmittedDefinition" messageRef="Message_AssessmentSubmitted" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_SubmittedToEvaluate" sourceRef="AssessmentSubmitted" targetRef="EvaluateAssessment" />
    <bpmn:businessRuleTask id="EvaluateAssessment" name="Evaluate Assessment" camunda:decisionRef="actionPlan" camunda:decisionRefBinding="latest" camunda:resultVariable="actionPlan" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="nextStep">${actionPlan.nextStep}</camunda:outputParameter>
          <camunda:outputParameter name="marketingAllowed">${emailConsent}</camunda:outputParameter>
          <camunda:outputParameter name="skipNurture">${false}</camunda:outputParameter>
          <camunda:outputParameter name="restartNurture">${false}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_EvaluateToSave" sourceRef="EvaluateAssessment" targetRef="SaveActionPlan" />
    <bpmn:serviceTask id="SaveActionPlan" name="Save Action Plan" camunda:asyncBefore="true" camunda:type="external" camunda:topic="crm.person.update">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="lifecycleStage">engaged_lead</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SaveToEmail" sourceRef="SaveActionPlan" targetRef="SendActionPlanEmail" />
    <bpmn:serviceTask id="SendActionPlanEmail" name="Send Action Plan email" camunda:type="external" camunda:topic="email.send">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="templateKey">action-plan</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EmailToSplit" sourceRef="SendActionPlanEmail" targetRef="AfterActionPlan" />
    <bpmn:parallelGateway id="AfterActionPlan" />
    <bpmn:sequenceFlow id="Flow_SplitToCallToday" sourceRef="AfterActionPlan" targetRef="CallTodayGateway" />
    <bpmn:sequenceFlow id="Flow_SplitToMarketing" sourceRef="AfterActionPlan" targetRef="MarketingPhase" />
    <bpmn:exclusiveGateway id="CallTodayGateway" name="Call today?" default="Flow_NoCallToday" />
    <bpmn:sequenceFlow id="Flow_CallToday" name="yes" sourceRef="CallTodayGateway" targetRef="SetCallDue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${actionPlan.callToday}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoCallToday" name="no" sourceRef="CallTodayGateway" targetRef="NoCallNeeded" />
    <bpmn:endEvent id="NoCallNeeded" name="No call needed" />
    <bpmn:businessRuleTask id="SetCallDue" name="Set call due time" camunda:decisionRef="taskDue" camunda:decisionRefBinding="latest" camunda:resultVariable="callDue" camunda:mapDecisionResult="singleEntry" />
    <bpmn:sequenceFlow id="Flow_DueToCall" sourceRef="SetCallDue" targetRef="CallToday" />
    <bpmn:userTask id="CallToday" name="Jimmy: call today" camunda:candidateGroups="originator" camunda:dueDate="${callDue}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="reached" label="I reached the person" type="boolean" />
          <camunda:formField id="notes" label="Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_CallToReached" sourceRef="CallToday" targetRef="ReachedGateway" />
    <bpmn:exclusiveGateway id="ReachedGateway" name="Not reached and SMS allowed?" default="Flow_CallDone" />
    <bpmn:sequenceFlow id="Flow_SendMissedCall" name="yes" sourceRef="ReachedGateway" targetRef="SendMissedCallSms">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!reached &amp;&amp; smsConsent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CallDone" name="no" sourceRef="ReachedGateway" targetRef="CallHandled" />
    <bpmn:serviceTask id="SendMissedCallSms" name="Send missed-call SMS" camunda:type="external" camunda:topic="sms.send">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="templateKey">missed-call</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SmsToCallHandled" sourceRef="SendMissedCallSms" targetRef="CallHandled" />
    <bpmn:endEvent id="CallHandled" name="Call handled" />
    <bpmn:subProcess id="MarketingPhase" name="Marketing phase">
      <bpmn:startEvent id="MarketingStarted" name="Marketing started" />
      <bpmn:sequenceFlow id="Flow_MarketingToSkip" sourceRef="MarketingStarted" targetRef="SkipNurtureGateway" />
      <bpmn:exclusiveGateway id="SkipNurtureGateway" name="Stay in Touch only?" default="Flow_ToNurture" />
      <bpmn:sequenceFlow id="Flow_ToNurture" name="no" sourceRef="SkipNurtureGateway" targetRef="NurtureSequence" />
      <bpmn:sequenceFlow id="Flow_SkipNurture" name="yes" sourceRef="SkipNurtureGateway" targetRef="StayInTouch">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${skipNurture}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:callActivity id="NurtureSequence" name="Nurture Sequence for the Next Step" calledElement="nurture-sequence" camunda:calledElementBinding="latest">
        <bpmn:extensionElements>
          <camunda:in businessKey="#{execution.processBusinessKey}" />
          <camunda:in source="nextStep" target="nextStep" />
          <camunda:in sourceExpression="${actionPlan.segment}" target="segment" />
          <camunda:in source="military" target="military" />
          <camunda:in source="senderBrand" target="senderBrand" />
          <camunda:in source="timeZone" target="timeZone" />
          <camunda:in sourceExpression="${1}" target="stepNumber" />
        </bpmn:extensionElements>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_NurtureToStayInTouch" sourceRef="NurtureSequence" targetRef="StayInTouch" />
      <bpmn:callActivity id="StayInTouch" name="Stay in Touch" calledElement="stay-in-touch" camunda:calledElementBinding="latest">
        <bpmn:extensionElements>
          <camunda:in businessKey="#{execution.processBusinessKey}" />
          <camunda:in source="senderBrand" target="senderBrand" />
          <camunda:in source="timeZone" target="timeZone" />
          <camunda:in sourceExpression="${0}" target="monthsWithoutAction" />
        </bpmn:extensionElements>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_StayInTouchToEnd" sourceRef="StayInTouch" targetRef="MarketingFinished" />
      <bpmn:endEvent id="MarketingFinished" name="Marketing finished" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_MarketingToEnd" sourceRef="MarketingPhase" targetRef="NoActionFor12Months" />
    <bpmn:endEvent id="NoActionFor12Months" name="12 months without any action" />
    <bpmn:boundaryEvent id="ConsultationBookedInMarketing" name="Consultation booked" attachedToRef="MarketingPhase">
      <bpmn:messageEventDefinition id="ConsultationBookedInMarketingDefinition" messageRef="Message_ConsultationBooked" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_BookedToConsultation" sourceRef="ConsultationBookedInMarketing" targetRef="Consultation" />
    <bpmn:boundaryEvent id="MarketingNotAllowed" name="Marketing not allowed" attachedToRef="MarketingPhase">
      <bpmn:conditionalEventDefinition id="MarketingNotAllowedDefinition" camunda:variableName="marketingAllowed">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${marketingAllowed == false}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_NotAllowedToWait" sourceRef="MarketingNotAllowed" targetRef="WaitWithoutMarketing" />
    <bpmn:eventBasedGateway id="WaitWithoutMarketing" name="Wait without marketing" />
    <bpmn:sequenceFlow id="Flow_WaitToBooked" sourceRef="WaitWithoutMarketing" targetRef="ConsultationBookedWithoutMarketing" />
    <bpmn:sequenceFlow id="Flow_WaitToTwelveMonths" sourceRef="WaitWithoutMarketing" targetRef="TwelveMonthsWithoutMarketing" />
    <bpmn:intermediateCatchEvent id="ConsultationBookedWithoutMarketing" name="Consultation booked">
      <bpmn:messageEventDefinition id="ConsultationBookedWithoutMarketingDefinition" messageRef="Message_ConsultationBooked" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_BookedWithoutMarketingToConsultation" sourceRef="ConsultationBookedWithoutMarketing" targetRef="Consultation" />
    <bpmn:intermediateCatchEvent id="TwelveMonthsWithoutMarketing" name="12 months">
      <bpmn:timerEventDefinition id="TwelveMonthsWithoutMarketingTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P12M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_TwelveMonthsToUnsubscribed" sourceRef="TwelveMonthsWithoutMarketing" targetRef="Unsubscribed" />
    <bpmn:endEvent id="Unsubscribed" name="Unsubscribed" />
    <bpmn:boundaryEvent id="NewAssessmentInMarketing" name="New Assessment" attachedToRef="MarketingPhase">
      <bpmn:conditionalEventDefinition id="NewAssessmentInMarketingDefinition" camunda:variableName="restartNurture">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${restartNurture == true}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_NewAssessmentToRestart" sourceRef="NewAssessmentInMarketing" targetRef="RestartNurture" />
    <bpmn:intermediateThrowEvent id="RestartNurture" name="Restart Nurture">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="restartNurture">${false}</camunda:outputParameter>
          <camunda:outputParameter name="skipNurture">${false}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_RestartToMarketing" sourceRef="RestartNurture" targetRef="MarketingPhase" />
    <bpmn:subProcess id="Consultation" name="Consultation">
      <bpmn:startEvent id="ConsultationStarted" name="Consultation booked" />
      <bpmn:sequenceFlow id="Flow_ConsultationToMql" sourceRef="ConsultationStarted" targetRef="MarkMarketingQualifiedLead" />
      <bpmn:serviceTask id="MarkMarketingQualifiedLead" name="Mark Marketing Qualified Lead" camunda:type="external" camunda:topic="crm.person.update">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="lifecycleStage">marketing_qualified_lead</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_MqlToWait" sourceRef="MarkMarketingQualifiedLead" targetRef="WaitForAppointment" />
      <bpmn:receiveTask id="WaitForAppointment" name="Wait for the appointment" messageRef="Message_AppointmentCompleted" />
      <bpmn:sequenceFlow id="Flow_CompletedToHappened" name="completed" sourceRef="WaitForAppointment" targetRef="ConsultationHappened" />
      <bpmn:boundaryEvent id="Reminder24h" name="24 h before" cancelActivity="false" attachedToRef="WaitForAppointment">
        <bpmn:timerEventDefinition id="Reminder24hTimer">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${dateTime().withMillis(appointmentAt.time).minusHours(24).toDate()}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_Reminder24hToSms" sourceRef="Reminder24h" targetRef="SendReminder24h" />
      <bpmn:serviceTask id="SendReminder24h" name="Send 24 h reminder SMS" camunda:type="external" camunda:topic="sms.send">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="templateKey">reminder-24h</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_Reminder24hToEnd" sourceRef="SendReminder24h" targetRef="Reminder24hSent" />
      <bpmn:endEvent id="Reminder24hSent" name="Reminder sent" />
      <bpmn:boundaryEvent id="Reminder1h" name="1 h before" cancelActivity="false" attachedToRef="WaitForAppointment">
        <bpmn:timerEventDefinition id="Reminder1hTimer">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${dateTime().withMillis(appointmentAt.time).minusHours(1).toDate()}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_Reminder1hToSms" sourceRef="Reminder1h" targetRef="SendReminder1h" />
      <bpmn:serviceTask id="SendReminder1h" name="Send 1 h reminder SMS" camunda:type="external" camunda:topic="sms.send">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="templateKey">reminder-1h</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_Reminder1hToEnd" sourceRef="SendReminder1h" targetRef="Reminder1hSent" />
      <bpmn:endEvent id="Reminder1hSent" name="Reminder sent" />
      <bpmn:boundaryEvent id="AppointmentMissed" name="Missed" attachedToRef="WaitForAppointment">
        <bpmn:messageEventDefinition id="AppointmentMissedDefinition" messageRef="Message_AppointmentMissed" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_MissedToReschedule" sourceRef="AppointmentMissed" targetRef="AskToReschedule" />
      <bpmn:boundaryEvent id="AppointmentCancelled" name="Cancelled" attachedToRef="WaitForAppointment">
        <bpmn:messageEventDefinition id="AppointmentCancelledDefinition" messageRef="Message_AppointmentCancelled" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_CancelledToReschedule" sourceRef="AppointmentCancelled" targetRef="AskToReschedule" />
      <bpmn:boundaryEvent id="AppointmentRescheduled" name="Rescheduled" attachedToRef="WaitForAppointment">
        <bpmn:messageEventDefinition id="AppointmentRescheduledDefinition" messageRef="Message_AppointmentRescheduled" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_RescheduledToWait" sourceRef="AppointmentRescheduled" targetRef="WaitForAppointment" />
      <bpmn:boundaryEvent id="NoAppointmentResult" name="2 h after, no result" attachedToRef="WaitForAppointment">
        <bpmn:timerEventDefinition id="NoAppointmentResultTimer">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${dateTime().withMillis(appointmentAt.time).plusHours(2).toDate()}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_NoResultToAsk" sourceRef="NoAppointmentResult" targetRef="DidConsultationHappen" />
      <bpmn:userTask id="DidConsultationHappen" name="Jimmy: did the Consultation happen?" camunda:candidateGroups="originator">
        <bpmn:extensionElements>
          <camunda:formData>
            <camunda:formField id="happened" label="The Consultation happened" type="boolean" />
          </camunda:formData>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_AskToHappenedGateway" sourceRef="DidConsultationHappen" targetRef="HappenedGateway" />
      <bpmn:exclusiveGateway id="HappenedGateway" name="Happened?" default="Flow_NotHappened" />
      <bpmn:sequenceFlow id="Flow_Happened" name="yes" sourceRef="HappenedGateway" targetRef="ConsultationHappened">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${happened}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_NotHappened" name="no" sourceRef="HappenedGateway" targetRef="AskToReschedule" />
      <bpmn:intermediateThrowEvent id="ConsultationHappened" name="Consultation completed">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="consultationExit">completed</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_HappenedToEnd" sourceRef="ConsultationHappened" targetRef="ConsultationCompleted" />
      <bpmn:endEvent id="ConsultationCompleted" name="Consultation completed" />
      <bpmn:userTask id="AskToReschedule" name="Team: ask to reschedule" camunda:candidateGroups="team">
        <bpmn:extensionElements>
          <camunda:formData>
            <camunda:formField id="result" label="Result" type="enum">
              <camunda:validation>
                <camunda:constraint name="required" />
              </camunda:validation>
              <camunda:value id="rebooked" name="Rebooked" />
              <camunda:value id="not_reached" name="Not reached" />
            </camunda:formField>
          </camunda:formData>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_RescheduleToResult" sourceRef="AskToReschedule" targetRef="RescheduleResultGateway" />
      <bpmn:exclusiveGateway id="RescheduleResultGateway" name="Rebooked?" default="Flow_NotReached" />
      <bpmn:sequenceFlow id="Flow_Rebooked" name="rebooked" sourceRef="RescheduleResultGateway" targetRef="WaitForNewBooking">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 'rebooked'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_NotReached" name="not reached" sourceRef="RescheduleResultGateway" targetRef="BackToMarketing" />
      <bpmn:eventBasedGateway id="WaitForNewBooking" name="Wait for the new booking" />
      <bpmn:sequenceFlow id="Flow_WaitToNewBooking" sourceRef="WaitForNewBooking" targetRef="NewBooking" />
      <bpmn:sequenceFlow id="Flow_WaitToNoBooking" sourceRef="WaitForNewBooking" targetRef="NoNewBooking" />
      <bpmn:intermediateCatchEvent id="NewBooking" name="Consultation booked">
        <bpmn:messageEventDefinition id="NewBookingDefinition" messageRef="Message_ConsultationBooked" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_NewBookingToWait" sourceRef="NewBooking" targetRef="WaitForAppointment" />
      <bpmn:intermediateCatchEvent id="NoNewBooking" name="14 days">
        <bpmn:timerEventDefinition id="NoNewBookingTimer">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_NoBookingToBack" sourceRef="NoNewBooking" targetRef="BackToMarketing" />
      <bpmn:intermediateThrowEvent id="BackToMarketing" name="Back to Stay in Touch">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="consultationExit">back_to_marketing</camunda:outputParameter>
            <camunda:outputParameter name="skipNurture">${true}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_BackToEnd" sourceRef="BackToMarketing" targetRef="ConsultationLeft" />
      <bpmn:endEvent id="ConsultationLeft" name="Consultation did not happen" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_ConsultationToExit" sourceRef="Consultation" targetRef="ConsultationExitGateway" />
    <bpmn:exclusiveGateway id="ConsultationExitGateway" name="Consultation completed?" default="Flow_ExitToMarketing" />
    <bpmn:sequenceFlow id="Flow_ExitCompleted" name="yes" sourceRef="ConsultationExitGateway" targetRef="RecordConsultationOutcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationExit == 'completed'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExitToMarketing" name="no" sourceRef="ConsultationExitGateway" targetRef="MarketingPhase" />
    <bpmn:userTask id="RecordConsultationOutcome" name="Jimmy: record Consultation Outcome" camunda:candidateGroups="originator">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="consultationOutcome" label="Consultation Outcome" type="enum">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
            <camunda:value id="opportunity" name="Opportunity" />
            <camunda:value id="preparation_needed" name="Preparation Needed" />
            <camunda:value id="not_moving_forward" name="Not Moving Forward" />
          </camunda:formField>
          <camunda:formField id="preparationReason" label="Preparation Reason (when Preparation Needed)" type="enum">
            <camunda:value id="wait_out_waiting_period" name="Wait out a waiting period" />
            <camunda:value id="fix_credit_first" name="Fix credit first" />
            <camunda:value id="get_steady_income_on_record_first" name="Get steady income on record first" />
            <camunda:value id="lower_debts_or_target_price_first" name="Lower debts or the target price first" />
            <camunda:value id="build_cash_first" name="Build cash first" />
            <camunda:value id="keep_renting_for_now" name="Keep renting for now" />
            <camunda:value id="learn_budget_now_pre_approve_later" name="Learn your budget now, get pre-approved later" />
            <camunda:value id="get_pre_approved_now" name="Get pre-approved now" />
            <camunda:value id="refinance_now" name="Refinance now" />
            <camunda:value id="keep_your_current_loan" name="Keep your current loan" />
            <camunda:value id="take_cash_out_with_care" name="Take cash out with care" />
            <camunda:value id="remove_mortgage_insurance" name="Remove mortgage insurance" />
            <camunda:value id="talk_it_through_with_jimmy" name="Talk it through with Jimmy" />
          </camunda:formField>
          <camunda:formField id="followUpDate" label="Follow-up call date (when Preparation Needed)" type="date" />
          <camunda:formField id="notes" label="Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_OutcomeToGateway" sourceRef="RecordConsultationOutcome" targetRef="OutcomeGateway" />
    <bpmn:exclusiveGateway id="OutcomeGateway" name="Consultation Outcome?" />
    <bpmn:sequenceFlow id="Flow_Opportunity" name="Opportunity" sourceRef="OutcomeGateway" targetRef="MarkSalesQualifiedLead">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationOutcome == 'opportunity'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PreparationNeeded" name="Preparation Needed" sourceRef="OutcomeGateway" targetRef="MarkPreparationNeeded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationOutcome == 'preparation_needed'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotMovingForward" name="Not Moving Forward" sourceRef="OutcomeGateway" targetRef="RecordNotMovingForward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${consultationOutcome == 'not_moving_forward'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="MarkSalesQualifiedLead" name="Mark Sales Qualified Lead" camunda:type="external" camunda:topic="crm.person.update">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="lifecycleStage">sales_qualified_lead</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SqlToOpportunity" sourceRef="MarkSalesQualifiedLead" targetRef="CreateOpportunity" />
    <bpmn:serviceTask id="CreateOpportunity" name="Create Opportunity" camunda:type="external" camunda:topic="crm.opportunity.create" />
    <bpmn:sequenceFlow id="Flow_OpportunityToWait" sourceRef="CreateOpportunity" targetRef="WaitForApplication" />
    <bpmn:intermediateCatchEvent id="WaitForApplication" name="60 days">
      <bpmn:timerEventDefinition id="WaitForApplicationTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P60D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_WaitToCheck" sourceRef="WaitForApplication" targetRef="CheckApplicationStatus" />
    <bpmn:userTask id="CheckApplicationStatus" name="Jimmy: check application status" camunda:candidateGroups="originator">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="status" label="Mortgage Application" type="enum">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
            <camunda:value id="started" name="Started" />
            <camunda:value id="not_yet" name="Not yet" />
            <camunda:value id="dropped" name="Dropped" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_CheckToStatus" sourceRef="CheckApplicationStatus" targetRef="ApplicationStatusGateway" />
    <bpmn:exclusiveGateway id="ApplicationStatusGateway" name="Application status?" />
    <bpmn:sequenceFlow id="Flow_ApplicationStarted" name="started" sourceRef="ApplicationStatusGateway" targetRef="ApplicationStarted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'started'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApplicationNotYet" name="not yet" sourceRef="ApplicationStatusGateway" targetRef="WaitForApplication">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'not_yet'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApplicationDropped" name="dropped" sourceRef="ApplicationStatusGateway" targetRef="StayInTouchOnly">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'dropped'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="ApplicationStarted" name="Application started" />
    <bpmn:serviceTask id="MarkPreparationNeeded" name="Mark Sales Qualified Lead with Preparation Reason" camunda:type="external" camunda:topic="crm.person.update">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="lifecycleStage">sales_qualified_lead</camunda:inputParameter>
          <camunda:inputParameter name="nextStep">${preparationReason}</camunda:inputParameter>
          <camunda:outputParameter name="nextStep">${preparationReason}</camunda:outputParameter>
          <camunda:outputParameter name="skipNurture">${false}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PreparationToSplit" sourceRef="MarkPreparationNeeded" targetRef="PreparationSplit" />
    <bpmn:parallelGateway id="PreparationSplit" />
    <bpmn:sequenceFlow id="Flow_PreparationToMarketing" name="Long-Term Nurture" sourceRef="PreparationSplit" targetRef="MarketingPhase" />
    <bpmn:sequenceFlow id="Flow_PreparationToFollowUp" sourceRef="PreparationSplit" targetRef="WaitForFollowUpDate" />
    <bpmn:intermediateCatchEvent id="WaitForFollowUpDate" name="Follow-up date">
      <bpmn:timerEventDefinition id="WaitForFollowUpDateTimer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${followUpDate}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_FollowUpDateToCall" sourceRef="WaitForFollowUpDate" targetRef="FollowUpCall" />
    <bpmn:userTask id="FollowUpCall" name="Team: follow-up call" camunda:candidateGroups="team,originator">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="result" label="Result" type="enum">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
            <camunda:value id="booked" name="Consultation booked" />
            <camunda:value id="not_ready" name="Not ready yet" />
            <camunda:value id="not_reached" name="Not reached" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_FollowUpToEnd" sourceRef="FollowUpCall" targetRef="FollowUpDone" />
    <bpmn:endEvent id="FollowUpDone" name="Follow-up done" />
    <bpmn:serviceTask id="RecordNotMovingForward" name="Record Not Moving Forward" camunda:type="external" camunda:topic="crm.person.update" />
    <bpmn:sequenceFlow id="Flow_NotMovingForwardToStayInTouch" sourceRef="RecordNotMovingForward" targetRef="StayInTouchOnly" />
    <bpmn:intermediateThrowEvent id="StayInTouchOnly" name="Stay in Touch only">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="skipNurture">${true}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_StayInTouchOnlyToMarketing" sourceRef="StayInTouchOnly" targetRef="MarketingPhase" />
    <bpmn:subProcess id="AssessmentRetakenSubprocess" name="New Assessment" triggeredByEvent="true">
      <bpmn:startEvent id="AssessmentRetaken" name="Assessment retaken" isInterrupting="false">
        <bpmn:messageEventDefinition id="AssessmentRetakenDefinition" messageRef="Message_AssessmentRetaken" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_RetakenToEvaluate" sourceRef="AssessmentRetaken" targetRef="EvaluateRetakenAssessment" />
      <bpmn:businessRuleTask id="EvaluateRetakenAssessment" name="Evaluate Assessment" camunda:decisionRef="actionPlan" camunda:decisionRefBinding="latest" camunda:resultVariable="actionPlan" camunda:mapDecisionResult="singleResult">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="nextStep">${actionPlan.nextStep}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_RetakenEvaluateToSave" sourceRef="EvaluateRetakenAssessment" targetRef="SaveRetakenActionPlan" />
      <bpmn:serviceTask id="SaveRetakenActionPlan" name="Save Action Plan" camunda:asyncBefore="true" camunda:type="external" camunda:topic="crm.person.update" />
      <bpmn:sequenceFlow id="Flow_RetakenSaveToEmail" sourceRef="SaveRetakenActionPlan" targetRef="SendRetakenActionPlanEmail" />
      <bpmn:serviceTask id="SendRetakenActionPlanEmail" name="Send Action Plan email" camunda:type="external" camunda:topic="email.send">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="templateKey">action-plan</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_RetakenEmailToRestart" sourceRef="SendRetakenActionPlanEmail" targetRef="RequestNurtureRestart" />
      <bpmn:intermediateThrowEvent id="RequestNurtureRestart" name="Restart Nurture when in marketing">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="restartNurture">${true}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_RestartToEnd" sourceRef="RequestNurtureRestart" targetRef="NewActionPlanSent" />
      <bpmn:endEvent id="NewActionPlanSent" name="New Action Plan sent" />
    </bpmn:subProcess>
    <bpmn:subProcess id="UnsubscribedSubprocess" name="Unsubscribe" triggeredByEvent="true">
      <bpmn:documentation>The Worker sets marketingAllowed = false in the correlation. That fires the Marketing phase's "Marketing not allowed" boundary. Appointment reminders are not marketing and continue.</bpmn:documentation>
      <bpmn:startEvent id="UnsubscribeReceived" name="Unsubscribed" isInterrupting="false">
        <bpmn:messageEventDefinition id="UnsubscribeReceivedDefinition" messageRef="Message_Unsubscribed" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_UnsubscribeToEnd" sourceRef="UnsubscribeReceived" targetRef="MarketingStopped" />
      <bpmn:endEvent id="MarketingStopped" name="Marketing stopped" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ApplicationStartedSubprocess" name="Mortgage Application started" triggeredByEvent="true">
      <bpmn:startEvent id="MortgageApplicationStarted" name="Mortgage Application started">
        <bpmn:messageEventDefinition id="MortgageApplicationStartedDefinition" messageRef="Message_MortgageApplicationStarted" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_ApplicationToRecord" sourceRef="MortgageApplicationStarted" targetRef="RecordApplicationStarted" />
      <bpmn:serviceTask id="RecordApplicationStarted" name="Record application started" camunda:type="external" camunda:topic="crm.person.update" />
      <bpmn:sequenceFlow id="Flow_RecordToEnd" sourceRef="RecordApplicationStarted" targetRef="ApplicationStartedEnd" />
      <bpmn:endEvent id="ApplicationStartedEnd" name="Application started" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_AssessmentSubmitted" name="AssessmentSubmitted" />
  <bpmn:message id="Message_AssessmentRetaken" name="AssessmentRetaken" />
  <bpmn:message id="Message_ConsultationBooked" name="ConsultationBooked" />
