<?xml version="1.0" encoding="UTF-8"?>
<!-- Disposable smoke-test process. Never holds business data: the business key is a fake Person ID. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="smoke-test-definitions"
                  targetNamespace="https://phxhomeloan.com/automation/smoke">
  <bpmn:process id="smoke-test" name="Smoke test (disposable)" isExecutable="true" camunda:historyTimeToLive="P7D">
    <bpmn:startEvent id="start" name="Smoke started">
      <bpmn:outgoing>to-echo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="echo" name="Worker echoes business key" camunda:type="external" camunda:topic="smoke-echo">
      <bpmn:incoming>to-echo</bpmn:incoming>
      <bpmn:outgoing>to-fork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="fork">
      <bpmn:incoming>to-fork</bpmn:incoming>
      <bpmn:outgoing>to-review</bpmn:outgoing>
      <bpmn:outgoing>to-timer</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="review" name="Complete smoke task">
      <bpmn:incoming>to-review</bpmn:incoming>
      <bpmn:outgoing>review-to-join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="timer" name="Short wait">
      <bpmn:incoming>to-timer</bpmn:incoming>
      <bpmn:outgoing>timer-to-join</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer-definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${timerDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="join">
      <bpmn:incoming>review-to-join</bpmn:incoming>
      <bpmn:incoming>timer-to-join</bpmn:incoming>
      <bpmn:outgoing>to-end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end" name="Smoke ended">
      <bpmn:incoming>to-end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="to-echo" sourceRef="start" targetRef="echo" />
    <bpmn:sequenceFlow id="to-fork" sourceRef="echo" targetRef="fork" />
    <bpmn:sequenceFlow id="to-review" sourceRef="fork" targetRef="review" />
    <bpmn:sequenceFlow id="to-timer" sourceRef="fork" targetRef="timer" />
    <bpmn:sequenceFlow id="review-to-join" sourceRef="review" targetRef="join" />
    <bpmn:sequenceFlow id="timer-to-join" sourceRef="timer" targetRef="join" />
    <bpmn:sequenceFlow id="to-end" sourceRef="join" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="smoke-test-diagram">
    <bpmndi:BPMNPlane id="smoke-test-plane" bpmnElement="smoke-test">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="echo_di" bpmnElement="echo">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="395" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_di" bpmnElement="timer">
        <dc:Bounds x="532" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="655" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="762" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to-echo_di" bpmnElement="to-echo">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-fork_di" bpmnElement="to-fork">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-review_di" bpmnElement="to-review">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="500" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-timer_di" bpmnElement="to-timer">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="230" />
        <di:waypoint x="532" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="review-to-join_di" bpmnElement="review-to-join">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="655" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="timer-to-join_di" bpmnElement="timer-to-join">
        <di:waypoint x="568" y="230" />
        <di:waypoint x="680" y="230" />
        <di:waypoint x="680" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-end_di" bpmnElement="to-end">
        <di:waypoint x="705" y="120" />
        <di:waypoint x="762" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
