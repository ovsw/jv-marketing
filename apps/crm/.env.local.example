# Clerk development application. Only the publishable key is public.
# The secret key is Sensitive in Vercel, so `vercel env pull` writes
# "[SENSITIVE]" for it. Paste the real value; `pnpm check:env` rejects the
# placeholder.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CRM_STAFF_EMAILS=you@example.com

# Intake database: the intake route writes here and the Person pages read here.
# Production uses the named Neon production branch; Preview and local work use
# development (the same value as PREVIEW_DATABASE_URL). Never expose this URL
# to a website. See docs/intake.md for caller provisioning.
DATABASE_URL=

# The staff test inquiry flow always uses the verified development branch.
PREVIEW_DATABASE_URL=

# Email is off by default. Only a staff address on this allowlist can receive mail.
RESEND_API_KEY=
RESEND_FROM="VA Loans for Vets <onboarding@resend.dev>"
TEST_EMAIL_ALLOWLIST=you@example.com
PREVIEW_EMAIL_ENABLED=false

# Server-only Trigger.dev key for this project's Development environment.
# Never prefix this key with NEXT_PUBLIC_.
TRIGGER_SECRET_KEY=
