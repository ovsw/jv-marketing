{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["shared/**", "scripts/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "CLERK_SECRET_KEY",
        "CRM_STAFF_EMAILS",
        "DATABASE_URL",
        "NEXT_ALLOWED_DEV_ORIGINS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SITE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "OG_IMAGE_SECRET",
        "PREVIEW_DATABASE_URL",
        "PREVIEW_EMAIL_ENABLED",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "RESEND_FROM",
        "SANITY_API_READ_TOKEN",
        "SANITY_STUDIO_API_VERSION",
        "SANITY_STUDIO_APP_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_HOSTNAME",
        "SANITY_STUDIO_PREVIEW_URL",
        "SANITY_STUDIO_PROJECT_ID",
        "TEST_EMAIL_ALLOWLIST",
        "TRIGGER_SECRET_KEY",
        "YOUTUBE_API_KEY"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "CLERK_SECRET_KEY",
        "CRM_STAFF_EMAILS",
        "DATABASE_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SITE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "OG_IMAGE_SECRET",
        "PREVIEW_DATABASE_URL",
        "PREVIEW_EMAIL_ENABLED",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "RESEND_FROM",
        "SANITY_API_READ_TOKEN",
        "SANITY_STUDIO_API_VERSION",
        "SANITY_STUDIO_APP_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_HOSTNAME",
        "SANITY_STUDIO_PREVIEW_URL",
        "SANITY_STUDIO_PROJECT_ID",
        "TEST_EMAIL_ALLOWLIST",
        "TRIGGER_SECRET_KEY",
        "YOUTUBE_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "env": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "env": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "CRM_STAFF_EMAILS",
        "PREVIEW_DATABASE_URL",
        "PREVIEW_EMAIL_ENABLED",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "TEST_EMAIL_ALLOWLIST",
        "TRIGGER_SECRET_KEY"
      ]
    },
    "test:intake": {
      "cache": false,
      "env": ["INTAKE_TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "CI",
        "CLERK_SECRET_KEY",
        "CRM_STAFF_EMAILS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SITE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "OG_IMAGE_SECRET",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_REUSE_BUILD",
        "PREVIEW_DATABASE_URL",
        "PREVIEW_EMAIL_ENABLED",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "RESEND_FROM",
        "SANITY_API_READ_TOKEN",
        "TEST_EMAIL_ALLOWLIST",
        "TRIGGER_SECRET_KEY",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "YOUTUBE_API_KEY"
      ]
    },
    "test:smoke": {
      "cache": false,
      "env": [
        "CI",
        "CLERK_SECRET_KEY",
        "CRM_STAFF_EMAILS",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SANITY_API_VERSION",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SITE_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "OG_IMAGE_SECRET",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_REUSE_BUILD",
        "PREVIEW_DATABASE_URL",
        "PREVIEW_EMAIL_ENABLED",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "RESEND_FROM",
        "SANITY_API_READ_TOKEN",
        "TEST_EMAIL_ALLOWLIST",
        "TRIGGER_SECRET_KEY",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "YOUTUBE_API_KEY"
      ]
    }
  }
}
