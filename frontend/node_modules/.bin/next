else
  export NODE_PATH="/work/dev/phx/phxhomeloancom-2026/node_modules/.pnpm/next@16.3.0_@babel+core@7.29.7_@playwright+test@1.62.1_@types+node@26.1.0_babel-plugin-_3b64392720bc9294ad1f40cae38bcee9/node_modules/next/node_modules:/work/dev/phx/phxhomeloancom-2026/node_modules/.pnpm/next@16.3.0_@babel+core@7.29.7_@playwright+test@1.62.1_@types+node@26.1.0_babel-plugin-_3b64392720bc9294ad1f40cae38bcee9/node_modules:/work/dev/phx/phxhomeloancom-2026/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../next/dist/bin/next" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../next/dist/bin/next" "$@"
elif command -v node >/dev/null 2>&1; then
